{
  "name": "@cloudflare-starter/storybook",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "storybook dev -p 6006",
    "build": "storybook build --output-dir ../web/public/_storybook --quiet",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@cloudflare-starter/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
