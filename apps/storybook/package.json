  },
  "devDependencies": {
    "@storybook/react-vite": "10.3.5",
    "@tailwindcss/vite": "4.2.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "storybook": "10.3.5",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "wrangler": "4.83.0"
  }
}
