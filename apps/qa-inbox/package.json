{
  "name": "@cloudflare-starter/qa-inbox",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy": "wrangler d1 migrations apply INBOX --remote && wrangler deploy"
  },
  "dependencies": {
    "postal-mime": "4.1.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261028.1",
    "typescript": "6.0.3",
    "wrangler": "4.158.0"
  }
}
