{
  "name": "@cloudflare-starter/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "bun run --filter @cloudflare-starter/storybook build && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "bun run --filter @cloudflare-starter/container deploy && bun run build && wrangler deploy",
    "deploy:staging": "bun run --filter @cloudflare-starter/container deploy:staging && CLOUDFLARE_ENV=staging bun run build && wrangler deploy",
    "deploy:production": "bun run --filter @cloudflare-starter/container deploy:production && CLOUDFLARE_ENV=production SITE_URL=https://starter.flooper.me bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "build:app": "astro build",
    "deploy:dry-run": "astro build && wrangler deploy --dry-run",
    "test:e2e": "playwright test",
    "test:e2e:build": "playwright test -c playwright.build.config.ts",
    "docs:screenshots": "playwright test -c playwright.screens.config.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.6",
    "@astrojs/react": "7.1.1",
    "@better-auth/mcp": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "@better-auth/passkey": "1.7.14",
    "@cloudflare-starter/features": "workspace:*",
    "@cloudflare-starter/ui": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.46",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "astro": "7.4.2",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.13",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "uqr": "0.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.14.0",
    "@better-auth/utils": "0.5.1",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261028.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.64.1",
    "beautiful-mermaid": "1.1.3",
    "pagefind": "1.5.2",
    "satteri": "0.10.5",
    "typescript": "6.0.3",
    "wrangler": "4.158.0"
  }
}
