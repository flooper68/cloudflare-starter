# Copy to apps/web/.dev.vars for local dev. Wrangler and `astro dev` read it.
# Deployed environments get these with `bunx wrangler secret put <NAME> --env <env>`.

# Core (required)
APP_URL=http://localhost:4321
# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=local-dev-secret-change-me-0000000000

# Google sign-in (optional) — the button appears only when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# R2 (optional) — required only for /app/upload-demo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_FILES_BUCKET_NAME=

# Mailjet (optional) — required for /app/email-demo and to deliver
# password-reset mail. Without it, reset links are printed to the dev log.
# Keep MAILJET_SANDBOX=true unless you intend to send real mail.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=
MAILJET_SANDBOX=true
