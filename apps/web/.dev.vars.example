# Copy to apps/web/.dev.vars for local dev (or run `bun run setup:secrets --env local`).
# Wrangler and `astro dev` read it. Blank values count as unset.
# Deployed environments get secrets with `bun run setup:secrets --env <env>`.

# Core (required)
# Overrides APP_ENV=develop from wrangler.jsonc: "local" marks this as local
# development, the only environment where auth links (which carry tokens) may be
# logged when email is off.
APP_ENV=local
# STORAGE_RECONCILE (required, no default): off | report | delete. off turns the optional
# daily orphan maintenance off; admins can still run a report on demand.
STORAGE_RECONCILE=off
# DEMO_MODE (required, no default): off | on. Starter-only public demo
# (docs/guides/how-to-run-a-public-demo.md); keep off. With on, also set
# DEMO_RETENTION_DAYS=7, DEMO_SAMPLE_DATA=on and optionally DEMO_PROTECTED_EMAILS=a@x.test,b@x.test.
DEMO_MODE=off
APP_URL=http://localhost:4321
# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=local-dev-secret-change-me-0000000000

# Sign-in methods. AUTH_EMAIL_PASSWORD and AUTH_REQUIRE_EMAIL_VERIFICATION are required
# (true | false, no default; wrangler.jsonc ships true and false, verification true in
# production). Google turns on when
# both keys are set. At least one method must be on.
AUTH_EMAIL_PASSWORD=true
AUTH_REQUIRE_EMAIL_VERIFICATION=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Workspaces and sign-up, for local development and tests only. Deployed environments
# have no defaults: `bun run setup:auth --env <env>` writes them into wrangler.jsonc, and
# the Worker refuses to start without them. docs/guides/how-to-configure-workspaces.md
# WORKSPACE_MODE: personal (one workspace per user) | single (one for the app) | multi
# SIGN_UP: open | invite (only invitees, SIGN_UP_DOMAINS and BOOTSTRAP_ADMIN_EMAIL)
# SIGN_UP_DOMAINS: comma list of email domains that may sign up without an invitation
# BOOTSTRAP_ADMIN_EMAIL: may always sign up; owns the workspace in single mode. Needs
#   AUTH_REQUIRE_EMAIL_VERIFICATION=true (or email + password off), or the app refuses to start.
WORKSPACE_MODE=multi
SIGN_UP=open
SIGN_UP_DOMAINS=
BOOTSTRAP_ADMIN_EMAIL=

# Admin portal (/admin and the admin_* MCP tools) for users with role=admin: on | off.
# Required, no default; deployed environments get it from `bun run setup:auth`. Make
# someone an admin with `bun run setup:admin --email <address>` (local D1 by default).
# docs/guides/how-to-use-admin-portal.md
ADMIN_PORTAL=on
# Billing, for local development and tests only. Deployed environments have no default:
# `bun run setup:auth --env <env>` writes it into wrangler.jsonc, and the Worker refuses
# to start without it. docs/guides/how-to-configure-plans-and-billing.md
# BILLING: off (everything unlimited) | manual (an admin sets plans) | provider (needs a
#   billing provider adapter registered in apps/web/src/server/billing-provider.ts)
BILLING=manual

# Explicit security policy (setup:auth writes deployed choices; no deployed defaults).
# TWO_FACTOR: off | optional | required-for-admins | required. Email OTP is recovery.
TWO_FACTOR=optional
TWO_FACTOR_EMAIL_OTP=off
# 0 disables remembered devices; maximum 30 days.
TWO_FACTOR_TRUSTED_DEVICE_DAYS=0
PASSKEYS=on

# Email (Cloudflare Email Service). Locally the EMAIL binding is simulated: mail
# is logged by the dev server, any sender works. Leave EMAIL_FROM blank to turn
# email off; auth and invitation links are then printed to the dev log (only with
# APP_ENV=local).
EMAIL_FROM=noreply@example.test
EMAIL_FROM_NAME=Cloudflare Starter

# Logging and error reports. LOG_SINK and ERROR_REPORTER are required vars set in
# apps/web/wrangler.jsonc for every environment (workers-logs | none); they are not
# secrets. To override them locally, uncomment a line here. Never leave one blank:
# a blank value here unsets the wrangler.jsonc var and every request fails with
# "LOG_SINK is not set". Guide: docs/guides/how-to-setup-logging.md
# LOG_SINK=none
# ERROR_REPORTER=none

# Feature flags. FEATURE_FLAGS is a required var set in apps/web/wrangler.jsonc for
# every environment: d1 (flags stored in the local D1, changed through the admin.flags
# procedures or MCP tools) or none (every flag is its catalog default). Same rule: to
# override locally, uncomment the line; never leave it blank.
# Guide: docs/guides/how-to-use-feature-flags.md
# FEATURE_FLAGS=none

# Abuse protection (docs/guides/how-to-configure-abuse-protection.md). RATE_LIMITING
# (cloudflare | none) and TURNSTILE (on | off) are required vars set in
# apps/web/wrangler.jsonc, with TURNSTILE_SITE_KEY; the ratelimits bindings are simulated
# locally. The site key there is Cloudflare's always-pass test key; this secret is its
# always-pass test secret, which accepts only the token the test widget produces. Swap in
# 2x00000000000000000000AB (site key, wrangler.jsonc) or 2x0000000000000000000000000000000AA
# (secret) to see failures. Same rule as above: uncomment to override, never leave blank.
# RATE_LIMITING=none
# TURNSTILE=off
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# The automated QA suite's bypass of the human check (QA_BYPASS: on | off, required, no
# default; docs/guides/how-to-configure-abuse-protection.md#qa-bypass). The top-level vars
# set it on for the develop deploy; local dev keeps it off (the E2E journeys run Turnstile
# with the test keys instead). With on, the QA_TOKEN secret (32+ characters, e.g.
# openssl rand -hex 32) and QA_EMAIL_DOMAIN (wrangler.jsonc) are required too.
QA_BYPASS=off
# QA_TOKEN=

# Security headers (docs/guides/how-to-configure-security-headers.md). CSP_MODE
# (enforce | report-only) is a required var set in apps/web/wrangler.jsonc; uncomment to
# try a policy change in report-only locally (never leave it blank).
# CSP_MODE=report-only

# The container workflow demo (/app/container-demo;
# docs/guides/how-to-run-container-workflows.md). CONTAINER_DEMO (on | off),
# CONTAINER_DEMO_DAILY_CAP (runs per UTC day) and CONTAINER_DEMO_RUNNER (container | fake)
# are required vars in apps/web/wrangler.jsonc; local dev gets the develop values: on, with
# the fake runner (pi computed in the Worker, no Docker). To run the real container
# locally, start both apps with `bun run dev` (needs Docker) and uncomment the runner line.
# Same rule: uncomment to override, never leave blank.
# CONTAINER_DEMO_RUNNER=container
# CONTAINER_DEMO=off

# Metrics and tracing. METRICS (analytics-engine | none) and TRACING (workers | none) are
# required vars in apps/web/wrangler.jsonc too, with the same rules: uncomment to override,
# never leave blank. Locally the METRICS_DATASET Analytics Engine binding is simulated and
# span records print in the dev server output. Guide:
# docs/guides/how-to-setup-metrics-and-tracing.md
# METRICS=none
# TRACING=none

# Product and web analytics (docs/guides/how-to-setup-product-analytics.md), for local
# development only: deployed environments get them from `bun run setup:analytics --env <env>`
# (written into wrangler.jsonc) and the Worker refuses to start without them.
# ANALYTICS: analytics-engine (product events to the ANALYTICS_EVENTS dataset, simulated
#   locally: nothing is stored) | none
# ANALYTICS_ID_SECRET: secret key of the pseudonymous user and workspace ids, 32+
#   characters; needed with analytics-engine. Generate with: openssl rand -base64 32
# WEB_ANALYTICS: cloudflare (cookieless Web Analytics beacon on every page) | none
# WEB_ANALYTICS_TOKEN: the site token from the Cloudflare dashboard, with cloudflare
ANALYTICS=analytics-engine
ANALYTICS_ID_SECRET=local-analytics-id-secret-change-me-000
WEB_ANALYTICS=none
WEB_ANALYTICS_TOKEN=

# R2 presigned URLs (optional). The FILES binding needs nothing here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_FILES_BUCKET_NAME=
