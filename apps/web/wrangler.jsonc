{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker: Astro serves HTTP, src/worker.ts adds the queue consumer and Cron Triggers.
  // Bindings are not inherited by `env.*`, so each environment repeats them.
  // Build for an environment with CLOUDFLARE_ENV=<env> (see the deploy:* scripts);
  // `wrangler deploy --env` does not retarget an already built bundle.
  "name": "cloudflare-starter-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs (console output, including the app's structured JSON logs and error
  // reports) and traces. Declared in every environment (docs/guides/how-to-setup-logging.md).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true }
  },
  // The deployed version id, logged as `release` with every line and error report.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Plain vars. Secrets (APP_URL, BETTER_AUTH_SECRET, ...) are set with `bun run setup:secrets`.
  // EMAIL_FROM is added per environment by `bun run setup:email`.
  // LOG_SINK and ERROR_REPORTER are required (no defaults): workers-logs | none.
  // AUTH_EMAIL_PASSWORD and AUTH_REQUIRE_EMAIL_VERIFICATION are required too (true | false,
  // no defaults; `bun run setup:auth` can change them; docs/guides/how-to-setup-auth.md).
  // Workspaces and sign-up are deliberately NOT set here: the Worker refuses to start
  // until `bun run setup:auth --env <env>` writes the project's choice into each
  // environment's vars (docs/guides/how-to-configure-workspaces.md):
  // - WORKSPACE_MODE: personal | single | multi (required)
  // - SIGN_UP: open | invite (required)
  // - SIGN_UP_DOMAINS: comma list of email domains that may sign up without an invitation
  // - BOOTSTRAP_ADMIN_EMAIL: may always sign up; owns the workspace in single mode; becomes a
  //   platform admin once verified
  // - ADMIN_PORTAL: on | off (required): the admin portal for role=admin users
  //   (docs/guides/how-to-use-admin-portal.md)
  // - TWO_FACTOR: off | optional | required-for-admins | required (required)
  // - TWO_FACTOR_EMAIL_OTP: on | off; TWO_FACTOR_TRUSTED_DEVICE_DAYS: 0..30
  // - PASSKEYS: on | off (required); docs/guides/how-to-configure-account-security.md
  // - BILLING: off | manual | provider (required; docs/guides/how-to-configure-plans-and-billing.md)
  // Local dev and the API tests get them from .dev.vars.example / apps/web/vitest.config.ts.
  // FEATURE_FLAGS is required (no default): d1 (flags in the DB, managed by admins) | none
  // (every flag is its catalog default). Guide: docs/guides/how-to-use-feature-flags.md
  // METRICS (analytics-engine | none) and TRACING (workers | none) are required too
  // (docs/guides/how-to-setup-metrics-and-tracing.md).
  // Product and web analytics are deliberately NOT set here either: whether an environment
  // collects anything is the owner's choice, written by `bun run setup:analytics --env <env>`
  // (docs/guides/how-to-setup-product-analytics.md):
  // - ANALYTICS: analytics-engine | none (required; analytics-engine needs the
  //   ANALYTICS_ID_SECRET secret)
  // - WEB_ANALYTICS: cloudflare | none (required), WEB_ANALYTICS_TOKEN with cloudflare
  "vars": {
    "APP_ENV": "develop",
    "LOG_SINK": "workers-logs",
    "ERROR_REPORTER": "workers-logs",
    "FEATURE_FLAGS": "d1",
    "METRICS": "analytics-engine",
    "TRACING": "workers",
    // The datasets the admin Analytics page reads with the SQL API: the same names as the
    // ANALYTICS_EVENTS and METRICS_DATASET bindings below (test/architecture/product-analytics.test.ts).
    "ANALYTICS_EVENTS_DATASET": "cloudflare_starter_develop_product_events",
    "METRICS_DATASET_NAME": "cloudflare_starter_develop_metrics",
    // Required, no default: off | report | delete (the daily orphan check itself is optional).
    "STORAGE_RECONCILE": "off",
    // Demo mode (starter-only; docs/guides/how-to-run-a-public-demo.md): off | on, required,
    // no default. With on, DEMO_RETENTION_DAYS (2..365) and DEMO_SAMPLE_DATA (on | off)
    // are required and DEMO_PROTECTED_EMAILS (comma list) is read; accounts older than
    // the retention are erased daily. Apps built from the starter keep off everywhere.
    // develop: off. It is the starter's own playground and its data should stay put.
    // The other DEMO_* vars are ignored with off; they are here so every environment
    // declares the same vars.
    "DEMO_MODE": "off",
    "DEMO_RETENTION_DAYS": "7",
    "DEMO_SAMPLE_DATA": "on",
    "DEMO_PROTECTED_EMAILS": "",
    // Content-Security-Policy of HTML pages: enforce | report-only. Required, no default
    // (docs/guides/how-to-configure-security-headers.md).
    "CSP_MODE": "enforce",
    "AUTH_EMAIL_PASSWORD": "true",
    "AUTH_REQUIRE_EMAIL_VERIFICATION": "false",
    "EMAIL_FROM_NAME": "Cloudflare Starter",
    // Abuse protection (docs/guides/how-to-configure-abuse-protection.md). Required:
    // RATE_LIMITING=cloudflare|none, TURNSTILE=on|off. With TURNSTILE=on the
    // TURNSTILE_SECRET_KEY secret is required too. The site key below is Cloudflare's
    // always-pass test key: replace it with your widget's (bun run setup:cloudflare prints how).
    "RATE_LIMITING": "cloudflare",
    "TURNSTILE": "on",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // The automated QA suite's bypass of the human check (required, no default: on | off;
    // docs/guides/how-to-configure-abuse-protection.md#qa-bypass). With on, a request with
    // the QA_TOKEN secret in X-QA-Token for an address @QA_EMAIL_DOMAIN skips Turnstile only.
    // develop: on, so the QA suite can run against a develop deploy before production
    // (needs the QA_TOKEN secret there). Local dev overrides it to off in .dev.vars.
    "QA_BYPASS": "on",
    "QA_EMAIL_DOMAIN": "qa.flooper.me",
    // The container workflow demo (docs/guides/how-to-run-container-workflows.md#settings).
    // Required, no defaults: CONTAINER_DEMO on | off, CONTAINER_DEMO_DAILY_CAP (runs per UTC
    // day for the whole deployment), CONTAINER_DEMO_RUNNER container | fake.
    // develop: on with the fake runner. The Workflow, D1, R2 and notifications run for real;
    // pi is computed in the Worker, so the develop deploy (and local dev, which starts from
    // these vars) starts no container. Set container to try the real one there.
    "CONTAINER_DEMO": "on",
    "CONTAINER_DEMO_DAILY_CAP": "50",
    "CONTAINER_DEMO_RUNNER": "fake"
  },
  // Create with `bunx wrangler d1 create <name>` and paste the id (docs/guides/how-to-setup-d1.md).
  // The placeholder id is enough for local dev.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-starter-develop",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/features/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "cloudflare-starter-files-develop" }
  ],
  // Workers Analytics Engine: the metrics (METRICS_DATASET, METRICS=analytics-engine;
  // docs/guides/how-to-setup-metrics-and-tracing.md) and the product events
  // (ANALYTICS_EVENTS, ANALYTICS=analytics-engine; docs/guides/how-to-setup-product-analytics.md),
  // one dataset each per environment. Datasets are created on the first write; simulated
  // locally (writes are accepted and not stored).
  "analytics_engine_datasets": [
    {
      "binding": "METRICS_DATASET",
      "dataset": "cloudflare_starter_develop_metrics"
    },
    {
      "binding": "ANALYTICS_EVENTS",
      "dataset": "cloudflare_starter_develop_product_events"
    }
  ],
  // Cloudflare Email Service. Simulated in local dev (mail is logged); deployed it needs
  // Workers Paid and a sender domain onboarded with `bun run setup:email`. Add
  // "allowed_sender_addresses" once the sender is known.
  "send_email": [{ "name": "EMAIL" }],
  // Background jobs (docs/guides/how-to-add-background-jobs.md). max_retries equals
  // JOB_MAX_RETRIES in packages/features (the consumer reports the final attempt); the
  // consumer acks or retries each message itself with the job's backoff, so retry_delay
  // only applies if a whole batch fails. The dead-letter queue has no consumer;
  // `bun run setup:cloudflare` creates it with the maximum message retention (14 days), a
  // queue setting that this file cannot hold. Checked by test/architecture/jobs.test.ts.
  "queues": {
    "producers": [
      { "binding": "APP_QUEUE", "queue": "cloudflare-starter-develop" }
    ],
    "consumers": [
      {
        "queue": "cloudflare-starter-develop",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "cloudflare-starter-develop-dlq"
      }
    ]
  },
  // Workers Rate Limiting: one binding per edge policy family of RATE_LIMIT_POLICIES
  // (packages/features/src/abuse/domain/policies.ts); limit and period must match it
  // (test/architecture/abuse.test.ts). Periods are 10 or 60 s. namespace_id is a positive
  // integer that must be unique in the whole Cloudflare ACCOUNT, not just this file: every
  // Worker binding the same id shares its counters. No resource to create. These ids
  // (7001–7015 develop, 8001–8015 staging, 9001–9015 production) are the starter's own; a
  // project built from it gets its own block from `bun run setup:cloudflare` (or
  // --namespace-base). Simulated locally.
  "ratelimits": [
    {
      "name": "RL_AUTH_IP",
      "namespace_id": "7001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "RL_MUTATION",
      "namespace_id": "7002",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "RL_MCP_IP",
      "namespace_id": "7006",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "RL_MCP_USER",
      "namespace_id": "7003",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RL_UPLOAD",
      "namespace_id": "7004",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "RL_INVITE",
      "namespace_id": "7005",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RL_TOKEN_LOOKUP",
      "namespace_id": "7007",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RL_BILLING_WEBHOOK",
      "namespace_id": "7008",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "RL_ANALYTICS",
      "namespace_id": "7009",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RL_UNSUBSCRIBE",
      "namespace_id": "7010",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "RL_HEALTH",
      "namespace_id": "7011",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RL_CSP_REPORT",
      "namespace_id": "7012",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RL_SITE_EVENTS",
      "namespace_id": "7015",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "RL_QA_BYPASS",
      "namespace_id": "7013",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RL_CONTAINER_RUN",
      "namespace_id": "7014",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  // The container workflow demo: its Workflow (class ContainerRunWorkflow in src/worker.ts;
  // created on deploy, nothing to create by hand; the name is account-wide, so one per
  // environment). Results go to the FILES bucket under workspaces/<id>/container-runs/.
  "workflows": [
    {
      "name": "cloudflare-starter-container-run",
      "binding": "CONTAINER_RUN_WORKFLOW",
      "class_name": "ContainerRunWorkflow"
    }
  ],
  // The pi container Worker (apps/container), CONTAINER_DEMO_RUNNER=container.
  "services": [
    {
      "binding": "PI_CONTAINER_SERVICE",
      "service": "cloudflare-starter-container"
    }
  ],
  // Cron Triggers (UTC): exactly the schedules of packages/features/src/cron-catalog.ts.
  "triggers": { "crons": ["0 8 * * *", "17 * * * *", "17 3 * * *"] },

  "env": {
    "staging": {
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": true },
        "traces": { "enabled": true }
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "APP_ENV": "staging",
        "LOG_SINK": "workers-logs",
        "ERROR_REPORTER": "workers-logs",
        "FEATURE_FLAGS": "d1",
        "METRICS": "analytics-engine",
        "TRACING": "workers",
        // The datasets the admin Analytics page reads with the SQL API: the same names as the
        // ANALYTICS_EVENTS and METRICS_DATASET bindings below (test/architecture/product-analytics.test.ts).
        "ANALYTICS_EVENTS_DATASET": "cloudflare_starter_staging_product_events",
        "METRICS_DATASET_NAME": "cloudflare_starter_staging_metrics",
        // Required, no default: off | report | delete (the daily orphan check itself is optional).
        "STORAGE_RECONCILE": "off",
        // staging: on, exactly as production, so a release rehearses the demo retention
        // (warning, then erasure a day later) before it reaches production.
        "DEMO_MODE": "on",
        "DEMO_RETENTION_DAYS": "7",
        "DEMO_SAMPLE_DATA": "on",
        "DEMO_PROTECTED_EMAILS": "",
        "CSP_MODE": "enforce",
        "AUTH_EMAIL_PASSWORD": "true",
        "AUTH_REQUIRE_EMAIL_VERIFICATION": "false",
        "EMAIL_FROM_NAME": "Cloudflare Starter",
        "RATE_LIMITING": "cloudflare",
        "TURNSTILE": "on",
        // Test key: replace with the staging widget's site key (bun run doctor warns).
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        // staging: off. No staging deployment runs the QA suite yet; switch to on with its
        // own QA_TOKEN secret when one does.
        "QA_BYPASS": "off",
        "QA_EMAIL_DOMAIN": "qa.flooper.me",
        // The container workflow demo (docs/guides/how-to-run-container-workflows.md#settings).
        // Required, no defaults: CONTAINER_DEMO on | off, CONTAINER_DEMO_DAILY_CAP (runs per UTC
        // day for the whole deployment), CONTAINER_DEMO_RUNNER container | fake.
        // staging: off. Turn on to rehearse the real container before a production change
        // (the pi container Worker is deployed to staging either way and costs nothing idle).
        "CONTAINER_DEMO": "off",
        "CONTAINER_DEMO_DAILY_CAP": "20",
        "CONTAINER_DEMO_RUNNER": "container"
      },
      "send_email": [{ "name": "EMAIL" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloudflare-starter-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/features/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "cloudflare-starter-files-staging"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "METRICS_DATASET",
          "dataset": "cloudflare_starter_staging_metrics"
        },
        {
          "binding": "ANALYTICS_EVENTS",
          "dataset": "cloudflare_starter_staging_product_events"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "APP_QUEUE", "queue": "cloudflare-starter-staging" }
        ],
        "consumers": [
          {
            "queue": "cloudflare-starter-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 30,
            "dead_letter_queue": "cloudflare-starter-staging-dlq"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "RL_AUTH_IP",
          "namespace_id": "8001",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "RL_MUTATION",
          "namespace_id": "8002",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "RL_MCP_IP",
          "namespace_id": "8006",
          "simple": { "limit": 600, "period": 60 }
        },
        {
          "name": "RL_MCP_USER",
          "namespace_id": "8003",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RL_UPLOAD",
          "namespace_id": "8004",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "RL_INVITE",
          "namespace_id": "8005",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "RL_TOKEN_LOOKUP",
          "namespace_id": "8007",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "RL_BILLING_WEBHOOK",
          "namespace_id": "8008",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "RL_ANALYTICS",
          "namespace_id": "8009",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RL_UNSUBSCRIBE",
          "namespace_id": "8010",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "RL_HEALTH",
          "namespace_id": "8011",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RL_CSP_REPORT",
          "namespace_id": "8012",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "RL_SITE_EVENTS",
          "namespace_id": "8015",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "RL_QA_BYPASS",
          "namespace_id": "8013",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "RL_CONTAINER_RUN",
          "namespace_id": "8014",
          "simple": { "limit": 3, "period": 60 }
        }
      ],
      // The container workflow demo: its Workflow (class ContainerRunWorkflow in src/worker.ts;
      // created on deploy, nothing to create by hand; the name is account-wide, so one per
      // environment). Results go to the FILES bucket under workspaces/<id>/container-runs/.
      "workflows": [
        {
          "name": "cloudflare-starter-container-run-staging",
          "binding": "CONTAINER_RUN_WORKFLOW",
          "class_name": "ContainerRunWorkflow"
        }
      ],
      // The pi container Worker (apps/container), CONTAINER_DEMO_RUNNER=container.
      "services": [
        {
          "binding": "PI_CONTAINER_SERVICE",
          "service": "cloudflare-starter-container-staging"
        }
      ],
      "triggers": { "crons": ["0 8 * * *", "17 * * * *", "17 3 * * *"] }
    },
    "production": {
      // Served only on its custom domain (Wrangler creates the DNS record and certificate on
      // deploy; the hostname's zone must be in this account and have no other record for
      // it). The APP_URL secret of this environment is https://starter.flooper.me.
      "routes": [{ "pattern": "starter.flooper.me", "custom_domain": true }],
      "workers_dev": false,
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": true },
        "traces": { "enabled": true }
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "APP_ENV": "production",
        "LOG_SINK": "workers-logs",
        "ERROR_REPORTER": "workers-logs",
        "FEATURE_FLAGS": "d1",
        "METRICS": "analytics-engine",
        "TRACING": "workers",
        // The datasets the admin Analytics page reads with the SQL API: the same names as the
        // ANALYTICS_EVENTS and METRICS_DATASET bindings below (test/architecture/product-analytics.test.ts).
        "ANALYTICS_EVENTS_DATASET": "cloudflare_starter_production_product_events",
        "METRICS_DATASET_NAME": "cloudflare_starter_production_metrics",
        // Required, no default: off | report | delete (the daily orphan check itself is optional).
        "STORAGE_RECONCILE": "report",
        // production: on (owner decision). The public site's "Try the demo app" points
        // here: accounts are warned a day before and erased after DEMO_RETENTION_DAYS.
        // Platform admins, BOOTSTRAP_ADMIN_EMAIL, QA_EMAIL_DOMAIN and the addresses below
        // are never erased: add the owner's other accounts to DEMO_PROTECTED_EMAILS.
        "DEMO_MODE": "on",
        "DEMO_RETENTION_DAYS": "7",
        "DEMO_SAMPLE_DATA": "on",
        "DEMO_PROTECTED_EMAILS": "",
        "CSP_MODE": "enforce",
        "AUTH_EMAIL_PASSWORD": "true",
        // Required by BOOTSTRAP_ADMIN_EMAIL; needs EMAIL_FROM (bun run setup:email).
        "AUTH_REQUIRE_EMAIL_VERIFICATION": "true",
        "EMAIL_FROM_NAME": "Cloudflare Starter",
        "RATE_LIMITING": "cloudflare",
        "TURNSTILE": "on",
        // Production widget cloudflare-starter-production (managed, starter.flooper.me).
        "TURNSTILE_SITE_KEY": "0x4AAAAAAF4nZzkSjYIfXj5g",
        // production: on (owner decision): the automated QA suite runs here after every
        // production deploy. Only addresses @qa.flooper.me with the QA_TOKEN secret skip
        // Turnstile; everyone else still solves it.
        "QA_BYPASS": "on",
        "QA_EMAIL_DOMAIN": "qa.flooper.me",
        "EMAIL_FROM": "starter@flooper.me",
        "TWO_FACTOR": "optional",
        "TWO_FACTOR_EMAIL_OTP": "on",
        "TWO_FACTOR_TRUSTED_DEVICE_DAYS": "30",
        "PASSKEYS": "on",
        "WORKSPACE_MODE": "multi",
        "SIGN_UP": "open",
        "SIGN_UP_DOMAINS": "",
        "BOOTSTRAP_ADMIN_EMAIL": "premysl.ciompa@gmail.com",
        "ADMIN_PORTAL": "on",
        "BILLING": "manual",
        "ANALYTICS": "analytics-engine",
        // Cloudflare Web Analytics, the app's own beacon (the manual-snippet site of
        // starter.flooper.me; owner decision 9 Nov 2026). Token and site tag are public:
        // the token is in every page, the site tag only names the site for the admin
        // Analytics page's GraphQL read.
        "WEB_ANALYTICS": "cloudflare",
        "WEB_ANALYTICS_TOKEN": "6a8410f937214193ad3a4e2c94c3b6e0",
        "WEB_ANALYTICS_SITE_TAG": "6afe1abb37c34a1cbb8bc3ab77f224c8",
        // The container workflow demo (docs/guides/how-to-run-container-workflows.md#settings).
        // Required, no defaults: CONTAINER_DEMO on | off, CONTAINER_DEMO_DAILY_CAP (runs per UTC
        // day for the whole deployment), CONTAINER_DEMO_RUNNER container | fake.
        // production: on (owner decision), the real container, at most 100 runs a day: inside the
        // plan's included usage, at most about $0.50 a month beyond it (docs/guides/how-to-run-container-workflows.md#what-it-costs).
        "CONTAINER_DEMO": "on",
        "CONTAINER_DEMO_DAILY_CAP": "100",
        "CONTAINER_DEMO_RUNNER": "container"
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["starter@flooper.me"]
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloudflare-starter-production",
          "database_id": "4f940521-26cd-4e54-a7fd-1d3470083c59",
          "migrations_dir": "../../packages/features/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "cloudflare-starter-files-production"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "METRICS_DATASET",
          "dataset": "cloudflare_starter_production_metrics"
        },
        {
          "binding": "ANALYTICS_EVENTS",
          "dataset": "cloudflare_starter_production_product_events"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "APP_QUEUE", "queue": "cloudflare-starter-production" }
        ],
        "consumers": [
          {
            "queue": "cloudflare-starter-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 30,
            "dead_letter_queue": "cloudflare-starter-production-dlq"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "RL_AUTH_IP",
          "namespace_id": "9001",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "RL_MUTATION",
          "namespace_id": "9002",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "RL_MCP_IP",
          "namespace_id": "9006",
          "simple": { "limit": 600, "period": 60 }
        },
        {
          "name": "RL_MCP_USER",
          "namespace_id": "9003",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RL_UPLOAD",
          "namespace_id": "9004",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "RL_INVITE",
          "namespace_id": "9005",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "RL_TOKEN_LOOKUP",
          "namespace_id": "9007",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "RL_BILLING_WEBHOOK",
          "namespace_id": "9008",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "RL_ANALYTICS",
          "namespace_id": "9009",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RL_UNSUBSCRIBE",
          "namespace_id": "9010",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "RL_HEALTH",
          "namespace_id": "9011",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RL_CSP_REPORT",
          "namespace_id": "9012",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "RL_SITE_EVENTS",
          "namespace_id": "9015",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "RL_QA_BYPASS",
          "namespace_id": "9013",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "RL_CONTAINER_RUN",
          "namespace_id": "9014",
          "simple": { "limit": 3, "period": 60 }
        }
      ],
      // The container workflow demo: its Workflow (class ContainerRunWorkflow in src/worker.ts;
      // created on deploy, nothing to create by hand; the name is account-wide, so one per
      // environment). Results go to the FILES bucket under workspaces/<id>/container-runs/.
      "workflows": [
        {
          "name": "cloudflare-starter-container-run-production",
          "binding": "CONTAINER_RUN_WORKFLOW",
          "class_name": "ContainerRunWorkflow"
        }
      ],
      // The pi container Worker (apps/container), CONTAINER_DEMO_RUNNER=container.
      "services": [
        {
          "binding": "PI_CONTAINER_SERVICE",
          "service": "cloudflare-starter-container-production"
        }
      ],
      "triggers": { "crons": ["0 8 * * *", "17 * * * *", "17 3 * * *"] }
    }
  }
}
