{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker: Astro serves HTTP, src/worker.ts adds the queue consumer and Cron Triggers.
  // Bindings are not inherited by `env.*`, so each environment repeats them.
  // Build for an environment with CLOUDFLARE_ENV=<env> (see the deploy:* scripts);
  // `wrangler deploy --env` does not retarget an already built bundle.
  "name": "cloudflare-starter-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs (console output, including the app's structured JSON logs and error
  // reports) and traces. Declared in every environment (docs/guides/how-to-setup-logging.md).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true }
  },
  // The deployed version id, logged as `release` with every line and error report.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Plain vars. Secrets (APP_URL, BETTER_AUTH_SECRET, ...) are set with `bun run setup:secrets`.
  // EMAIL_FROM is added per environment by `bun run setup:email`.
  // LOG_SINK and ERROR_REPORTER are required (no defaults): workers-logs | none.
  // Workspaces and sign-up are deliberately NOT set here: the Worker refuses to start
  // until `bun run setup:auth --env <env>` writes the project's choice into each
  // environment's vars (docs/guides/how-to-configure-workspaces.md):
  // - WORKSPACE_MODE: personal | single | multi (required)
  // - SIGN_UP: open | invite (required)
  // - SIGN_UP_DOMAINS: comma list of email domains that may sign up without an invitation
  // - BOOTSTRAP_ADMIN_EMAIL: may always sign up; owns the workspace in single mode; becomes a
  //   platform admin once verified
  // - ADMIN_PORTAL: on | off (required): the admin portal for role=admin users
  //   (docs/guides/how-to-use-admin-portal.md)
  // - TWO_FACTOR: off | optional | required-for-admins | required (required)
  // - TWO_FACTOR_EMAIL_OTP: on | off; TWO_FACTOR_TRUSTED_DEVICE_DAYS: 0..30
  // - PASSKEYS: on | off (required); docs/guides/how-to-configure-account-security.md
  // - BILLING: off | manual | provider (required; docs/guides/how-to-configure-plans-and-billing.md)
  // Local dev and the API tests get them from .dev.vars.example / apps/web/vitest.config.ts.
  // FEATURE_FLAGS is required (no default): d1 (flags in the DB, managed by admins) | none
  // (every flag is its catalog default). Guide: docs/guides/how-to-use-feature-flags.md
  // METRICS (analytics-engine | none) and TRACING (workers | none) are required too
  // (docs/guides/how-to-setup-metrics-and-tracing.md).
  // Product and web analytics are deliberately NOT set here either: whether an environment
  // collects anything is the owner's choice, written by `bun run setup:analytics --env <env>`
  // (docs/guides/how-to-setup-product-analytics.md):
  // - ANALYTICS: analytics-engine | none (required; analytics-engine needs the
  //   ANALYTICS_ID_SECRET secret)
  // - WEB_ANALYTICS: cloudflare | none (required), WEB_ANALYTICS_TOKEN with cloudflare
  "vars": {
    "APP_ENV": "develop",
    "LOG_SINK": "workers-logs",
    "ERROR_REPORTER": "workers-logs",
    "FEATURE_FLAGS": "d1",
    "METRICS": "analytics-engine",
    "TRACING": "workers",
    // Optional daily orphan storage check; off | report | delete.
    "STORAGE_RECONCILE": "off",
    // Content-Security-Policy of HTML pages: enforce | report-only. Required, no default
    // (docs/guides/how-to-configure-security-headers.md).
    "CSP_MODE": "enforce",
    "AUTH_EMAIL_PASSWORD": "true",
    "AUTH_REQUIRE_EMAIL_VERIFICATION": "false",
    "EMAIL_FROM_NAME": "Cloudflare Starter",
    // Abuse protection (docs/guides/how-to-configure-abuse-protection.md). Required:
    // RATE_LIMITING=cloudflare|none, TURNSTILE=on|off. With TURNSTILE=on the
    // TURNSTILE_SECRET_KEY secret is required too. The site key below is Cloudflare's
    // always-pass test key: replace it with your widget's (bun run setup:cloudflare prints how).
    "RATE_LIMITING": "cloudflare",
    "TURNSTILE": "on",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },
  // Create with `bunx wrangler d1 create <name>` and paste the id (docs/guides/how-to-setup-d1.md).
  // The placeholder id is enough for local dev.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-starter-develop",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/features/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "cloudflare-starter-files-develop" }
  ],
  // Workers Analytics Engine: the metrics (METRICS_DATASET, METRICS=analytics-engine;
  // docs/guides/how-to-setup-metrics-and-tracing.md) and the product events
  // (ANALYTICS_EVENTS, ANALYTICS=analytics-engine; docs/guides/how-to-setup-product-analytics.md),
  // one dataset each per environment. Datasets are created on the first write; simulated
  // locally (writes are accepted and not stored).
  "analytics_engine_datasets": [
    {
      "binding": "METRICS_DATASET",
      "dataset": "cloudflare_starter_develop_metrics"
    },
    {
      "binding": "ANALYTICS_EVENTS",
      "dataset": "cloudflare_starter_develop_product_events"
    }
  ],
  // Cloudflare Email Service. Simulated in local dev (mail is logged); deployed it needs
  // Workers Paid and a sender domain onboarded with `bun run setup:email`. Add
  // "allowed_sender_addresses" once the sender is known.
  "send_email": [{ "name": "EMAIL" }],
  // Background jobs (docs/guides/how-to-add-background-jobs.md). max_retries equals
  // JOB_MAX_RETRIES in packages/features (the consumer reports the final attempt); the
  // consumer acks or retries each message itself with the job's backoff, so retry_delay
  // only applies if a whole batch fails. The dead-letter queue has no consumer;
  // `bun run setup:cloudflare` creates it with the maximum message retention (14 days), a
  // queue setting that this file cannot hold. Checked by test/architecture/jobs.test.ts.
  "queues": {
    "producers": [
      { "binding": "APP_QUEUE", "queue": "cloudflare-starter-develop" }
    ],
    "consumers": [
      {
        "queue": "cloudflare-starter-develop",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "cloudflare-starter-develop-dlq"
      }
    ]
  },
  // Workers Rate Limiting: one binding per edge policy family of RATE_LIMIT_POLICIES
  // (packages/features/src/abuse/domain/policies.ts); limit and period must match it
  // (test/architecture/abuse.test.ts). Periods are 10 or 60 s. namespace_id is a positive
  // integer that must be unique in the whole Cloudflare ACCOUNT, not just this file: every
  // Worker binding the same id shares its counters. No resource to create. These ids
  // (7001–7012 develop, 8001–8012 staging, 9001–9012 production) are the starter's own; a
  // project built from it gets its own block from `bun run setup:cloudflare` (or
  // --namespace-base). Simulated locally.
  "ratelimits": [
    {
      "name": "RL_AUTH_IP",
      "namespace_id": "7001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "RL_MUTATION",
      "namespace_id": "7002",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "RL_MCP_IP",
      "namespace_id": "7006",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "RL_MCP_USER",
      "namespace_id": "7003",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RL_UPLOAD",
      "namespace_id": "7004",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "RL_INVITE",
      "namespace_id": "7005",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RL_TOKEN_LOOKUP",
      "namespace_id": "7007",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RL_BILLING_WEBHOOK",
      "namespace_id": "7008",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "RL_ANALYTICS",
      "namespace_id": "7009",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RL_UNSUBSCRIBE",
      "namespace_id": "7010",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "RL_HEALTH",
      "namespace_id": "7011",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RL_CSP_REPORT",
      "namespace_id": "7012",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // Cron Triggers (UTC): exactly the schedules of packages/features/src/cron-catalog.ts.
  "triggers": { "crons": ["0 8 * * *", "17 * * * *", "17 3 * * *"] },

  "env": {
    "staging": {
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": true },
        "traces": { "enabled": true }
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "APP_ENV": "staging",
        "LOG_SINK": "workers-logs",
        "ERROR_REPORTER": "workers-logs",
        "FEATURE_FLAGS": "d1",
        "METRICS": "analytics-engine",
        "TRACING": "workers",
        // Optional daily orphan storage check; off | report | delete.
        "STORAGE_RECONCILE": "off",
        "CSP_MODE": "enforce",
        "AUTH_EMAIL_PASSWORD": "true",
        "AUTH_REQUIRE_EMAIL_VERIFICATION": "false",
        "EMAIL_FROM_NAME": "Cloudflare Starter",
        "RATE_LIMITING": "cloudflare",
        "TURNSTILE": "on",
        // Test key: replace with the staging widget's site key (bun run doctor warns).
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
      },
      "send_email": [{ "name": "EMAIL" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloudflare-starter-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/features/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "cloudflare-starter-files-staging"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "METRICS_DATASET",
          "dataset": "cloudflare_starter_staging_metrics"
        },
        {
          "binding": "ANALYTICS_EVENTS",
          "dataset": "cloudflare_starter_staging_product_events"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "APP_QUEUE", "queue": "cloudflare-starter-staging" }
        ],
        "consumers": [
          {
            "queue": "cloudflare-starter-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 30,
            "dead_letter_queue": "cloudflare-starter-staging-dlq"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "RL_AUTH_IP",
          "namespace_id": "8001",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "RL_MUTATION",
          "namespace_id": "8002",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "RL_MCP_IP",
          "namespace_id": "8006",
          "simple": { "limit": 600, "period": 60 }
        },
        {
          "name": "RL_MCP_USER",
          "namespace_id": "8003",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RL_UPLOAD",
          "namespace_id": "8004",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "RL_INVITE",
          "namespace_id": "8005",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "RL_TOKEN_LOOKUP",
          "namespace_id": "8007",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "RL_BILLING_WEBHOOK",
          "namespace_id": "8008",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "RL_ANALYTICS",
          "namespace_id": "8009",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RL_UNSUBSCRIBE",
          "namespace_id": "8010",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "RL_HEALTH",
          "namespace_id": "8011",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RL_CSP_REPORT",
          "namespace_id": "8012",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "triggers": { "crons": ["0 8 * * *", "17 * * * *", "17 3 * * *"] }
    },
    "production": {
      // Served only on its custom domain (Wrangler creates the DNS record and certificate on
      // deploy; the hostname's zone must be in this account and have no other record for
      // it). The APP_URL secret of this environment is https://starter.flooper.me.
      "routes": [{ "pattern": "starter.flooper.me", "custom_domain": true }],
      "workers_dev": false,
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": true },
        "traces": { "enabled": true }
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "APP_ENV": "production",
        "LOG_SINK": "workers-logs",
        "ERROR_REPORTER": "workers-logs",
        "FEATURE_FLAGS": "d1",
        "METRICS": "analytics-engine",
        "TRACING": "workers",
        // Optional daily orphan storage check; off | report | delete.
        "STORAGE_RECONCILE": "report",
        "CSP_MODE": "enforce",
        "AUTH_EMAIL_PASSWORD": "true",
        // Required by BOOTSTRAP_ADMIN_EMAIL; needs EMAIL_FROM (bun run setup:email).
        "AUTH_REQUIRE_EMAIL_VERIFICATION": "true",
        "EMAIL_FROM_NAME": "Cloudflare Starter",
        "RATE_LIMITING": "cloudflare",
        "TURNSTILE": "on",
        // Test key: replace with the production widget's site key (bun run doctor warns).
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "EMAIL_FROM": "starter@flooper.me",
        "TWO_FACTOR": "optional",
        "TWO_FACTOR_EMAIL_OTP": "on",
        "TWO_FACTOR_TRUSTED_DEVICE_DAYS": "30",
        "PASSKEYS": "on",
        "WORKSPACE_MODE": "multi",
        "SIGN_UP": "open",
        "SIGN_UP_DOMAINS": "",
        "BOOTSTRAP_ADMIN_EMAIL": "premysl.ciompa@gmail.com",
        "ADMIN_PORTAL": "on",
        "BILLING": "manual",
        "ANALYTICS": "analytics-engine",
        "WEB_ANALYTICS": "none",
        "WEB_ANALYTICS_TOKEN": ""
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["starter@flooper.me"]
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloudflare-starter-production",
          "database_id": "4f940521-26cd-4e54-a7fd-1d3470083c59",
          "migrations_dir": "../../packages/features/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "cloudflare-starter-files-production"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "METRICS_DATASET",
          "dataset": "cloudflare_starter_production_metrics"
        },
        {
          "binding": "ANALYTICS_EVENTS",
          "dataset": "cloudflare_starter_production_product_events"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "APP_QUEUE", "queue": "cloudflare-starter-production" }
        ],
        "consumers": [
          {
            "queue": "cloudflare-starter-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 30,
            "dead_letter_queue": "cloudflare-starter-production-dlq"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "RL_AUTH_IP",
          "namespace_id": "9001",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "RL_MUTATION",
          "namespace_id": "9002",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "RL_MCP_IP",
          "namespace_id": "9006",
          "simple": { "limit": 600, "period": 60 }
        },
        {
          "name": "RL_MCP_USER",
          "namespace_id": "9003",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RL_UPLOAD",
          "namespace_id": "9004",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "RL_INVITE",
          "namespace_id": "9005",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "RL_TOKEN_LOOKUP",
          "namespace_id": "9007",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "RL_BILLING_WEBHOOK",
          "namespace_id": "9008",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "RL_ANALYTICS",
          "namespace_id": "9009",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RL_UNSUBSCRIBE",
          "namespace_id": "9010",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "RL_HEALTH",
          "namespace_id": "9011",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RL_CSP_REPORT",
          "namespace_id": "9012",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "triggers": { "crons": ["0 8 * * *", "17 * * * *", "17 3 * * *"] }
    }
  }
}
