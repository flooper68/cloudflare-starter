{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker: Astro serves HTTP, src/worker.ts adds the queue consumer and Cron Triggers.
  // Bindings are not inherited by `env.*`, so each environment repeats them.
  // Build for an environment with CLOUDFLARE_ENV=<env> (see the deploy:* scripts);
  // `wrangler deploy --env` does not retarget an already built bundle.
  "name": "cloudflare-starter-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs (console output, including the app's structured JSON logs and error
  // reports) and traces. Declared in every environment (docs/guides/how-to-setup-logging.md).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true }
  },
  // The deployed version id, logged as `release` with every line and error report.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Plain vars. Secrets (APP_URL, BETTER_AUTH_SECRET, ...) are set with `bun run setup:secrets`.
  // EMAIL_FROM is added per environment by `bun run setup:email`.
  // LOG_SINK and ERROR_REPORTER are required (no defaults): workers-logs | none.
  // Workspaces and sign-up are deliberately NOT set here: the Worker refuses to start
  // until `bun run setup:auth --env <env>` writes the project's choice into each
  // environment's vars (docs/guides/how-to-configure-workspaces.md):
  // - WORKSPACE_MODE: personal | single | multi (required)
  // - SIGN_UP: open | invite (required)
  // - SIGN_UP_DOMAINS: comma list of email domains that may sign up without an invitation
  // - BOOTSTRAP_ADMIN_EMAIL: may always sign up; owns the workspace in single mode; becomes a
  //   platform admin once verified
  // - ADMIN_PORTAL: on | off (required): the admin portal for role=admin users
  //   (docs/guides/how-to-use-admin-portal.md)
  // - BILLING: off | manual | provider (required; docs/guides/how-to-configure-plans-and-billing.md)
  // Local dev and the API tests get them from .dev.vars.example / apps/web/vitest.config.ts.
  // FEATURE_FLAGS is required (no default): d1 (flags in the DB, managed by admins) | none
  // (every flag is its catalog default). Guide: docs/guides/how-to-use-feature-flags.md
  // METRICS (analytics-engine | none) and TRACING (workers | none) are required too
  // (docs/guides/how-to-setup-metrics-and-tracing.md).
  "vars": {
    "APP_ENV": "develop",
    "LOG_SINK": "workers-logs",
    "ERROR_REPORTER": "workers-logs",
    "FEATURE_FLAGS": "d1",
    "METRICS": "analytics-engine",
    "TRACING": "workers",
    "AUTH_EMAIL_PASSWORD": "true",
    "AUTH_REQUIRE_EMAIL_VERIFICATION": "false",
    "EMAIL_FROM_NAME": "Cloudflare Starter",
    // Abuse protection (docs/guides/how-to-configure-abuse-protection.md). Required:
    // RATE_LIMITING=cloudflare|none, TURNSTILE=on|off. With TURNSTILE=on the
    // TURNSTILE_SECRET_KEY secret is required too. The site key below is Cloudflare's
    // always-pass test key: replace it with your widget's (bun run setup:cloudflare prints how).
    "RATE_LIMITING": "cloudflare",
    "TURNSTILE": "on",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },
  // Create with `bunx wrangler d1 create <name>` and paste the id (docs/guides/how-to-setup-d1.md).
  // The placeholder id is enough for local dev.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-starter-develop",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/features/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "cloudflare-starter-files-develop" }
  ],
  // Workers Analytics Engine: the metrics (METRICS=analytics-engine). The dataset is created
  // on the first write; simulated locally. Data-point layout and queries:
  // docs/guides/how-to-setup-metrics-and-tracing.md
  "analytics_engine_datasets": [
    {
      "binding": "METRICS_DATASET",
      "dataset": "cloudflare_starter_develop_metrics"
    }
  ],
  // Cloudflare Email Service. Simulated in local dev (mail is logged); deployed it needs
  // Workers Paid and a sender domain onboarded with `bun run setup:email`. Add
  // "allowed_sender_addresses" once the sender is known.
  "send_email": [{ "name": "EMAIL" }],
  // Background jobs (docs/guides/how-to-add-background-jobs.md). max_retries equals
  // JOB_MAX_RETRIES in packages/features (the consumer reports the final attempt); the
  // consumer acks or retries each message itself with the job's backoff, so retry_delay
  // only applies if a whole batch fails. The dead-letter queue has no consumer;
  // `bun run setup:cloudflare` creates it with the maximum message retention (14 days), a
  // queue setting that this file cannot hold. Checked by test/architecture/jobs.test.ts.
  "queues": {
    "producers": [
      { "binding": "APP_QUEUE", "queue": "cloudflare-starter-develop" }
    ],
    "consumers": [
      {
        "queue": "cloudflare-starter-develop",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "cloudflare-starter-develop-dlq"
      }
    ]
  },
  // Workers Rate Limiting: one binding per edge policy family of RATE_LIMIT_POLICIES
  // (packages/features/src/abuse/domain/policies.ts); limit and period must match it
  // (test/architecture/abuse.test.ts). Periods are 10 or 60 s. namespace_id is any
  // integer you choose, unique in the account: no resource to create. Each environment
  // uses its own ids so their counters stay apart. Simulated locally.
  "ratelimits": [
    {
      "name": "RL_AUTH_IP",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "RL_MUTATION",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "RL_MCP_IP",
      "namespace_id": "1006",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "RL_MCP_USER",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RL_UPLOAD",
      "namespace_id": "1004",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "RL_INVITE",
      "namespace_id": "1005",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RL_TOKEN_LOOKUP",
      "namespace_id": "1007",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RL_BILLING_WEBHOOK",
      "namespace_id": "1008",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  // Cron Triggers (UTC): exactly the schedules of packages/features/src/cron-catalog.ts.
  "triggers": { "crons": ["17 3 * * *"] },

  "env": {
    "staging": {
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": true },
        "traces": { "enabled": true }
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "APP_ENV": "staging",
        "LOG_SINK": "workers-logs",
        "ERROR_REPORTER": "workers-logs",
        "FEATURE_FLAGS": "d1",
        "METRICS": "analytics-engine",
        "TRACING": "workers",
        "AUTH_EMAIL_PASSWORD": "true",
        "AUTH_REQUIRE_EMAIL_VERIFICATION": "false",
        "EMAIL_FROM_NAME": "Cloudflare Starter",
        "RATE_LIMITING": "cloudflare",
        "TURNSTILE": "on",
        // Test key: replace with the staging widget's site key (bun run doctor warns).
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
      },
      "send_email": [{ "name": "EMAIL" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloudflare-starter-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/features/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "cloudflare-starter-files-staging"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "METRICS_DATASET",
          "dataset": "cloudflare_starter_staging_metrics"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "APP_QUEUE", "queue": "cloudflare-starter-staging" }
        ],
        "consumers": [
          {
            "queue": "cloudflare-starter-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 30,
            "dead_letter_queue": "cloudflare-starter-staging-dlq"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "RL_AUTH_IP",
          "namespace_id": "2001",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "RL_MUTATION",
          "namespace_id": "2002",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "RL_MCP_IP",
          "namespace_id": "2006",
          "simple": { "limit": 600, "period": 60 }
        },
        {
          "name": "RL_MCP_USER",
          "namespace_id": "2003",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RL_UPLOAD",
          "namespace_id": "2004",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "RL_INVITE",
          "namespace_id": "2005",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "RL_TOKEN_LOOKUP",
          "namespace_id": "2007",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "RL_BILLING_WEBHOOK",
          "namespace_id": "2008",
          "simple": { "limit": 300, "period": 60 }
        }
      ],
      "triggers": { "crons": ["17 3 * * *"] }
    },
    "production": {
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": true },
        "traces": { "enabled": true }
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "APP_ENV": "production",
        "LOG_SINK": "workers-logs",
        "ERROR_REPORTER": "workers-logs",
        "FEATURE_FLAGS": "d1",
        "METRICS": "analytics-engine",
        "TRACING": "workers",
        "AUTH_EMAIL_PASSWORD": "true",
        "AUTH_REQUIRE_EMAIL_VERIFICATION": "false",
        "EMAIL_FROM_NAME": "Cloudflare Starter",
        "RATE_LIMITING": "cloudflare",
        "TURNSTILE": "on",
        // Test key: replace with the production widget's site key (bun run doctor warns).
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
      },
      "send_email": [{ "name": "EMAIL" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloudflare-starter-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/features/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "cloudflare-starter-files-production"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "METRICS_DATASET",
          "dataset": "cloudflare_starter_production_metrics"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "APP_QUEUE", "queue": "cloudflare-starter-production" }
        ],
        "consumers": [
          {
            "queue": "cloudflare-starter-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 30,
            "dead_letter_queue": "cloudflare-starter-production-dlq"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "RL_AUTH_IP",
          "namespace_id": "3001",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "RL_MUTATION",
          "namespace_id": "3002",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "RL_MCP_IP",
          "namespace_id": "3006",
          "simple": { "limit": 600, "period": 60 }
        },
        {
          "name": "RL_MCP_USER",
          "namespace_id": "3003",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RL_UPLOAD",
          "namespace_id": "3004",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "RL_INVITE",
          "namespace_id": "3005",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "RL_TOKEN_LOOKUP",
          "namespace_id": "3007",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "RL_BILLING_WEBHOOK",
          "namespace_id": "3008",
          "simple": { "limit": 300, "period": 60 }
        }
      ],
      "triggers": { "crons": ["17 3 * * *"] }
    }
  }
}
