---
/**
 * The document shell of the server-rendered account pages (sign-in, sign-up, password
 * reset, verification, invitations, consent). The header is the public site's
 * (SiteHeader: Docs, Changelog, GitHub, the theme switch, Sign in and Try the demo, or
 * Open app when signed in). These pages are rendered per request under the page policy,
 * which runs scripts from /_astro/ and the one file /site-theme.js (the saved theme,
 * applied before the first paint, as on the public pages).
 */
import "@cloudflare-starter/ui/globals.css";
import "@/styles/globals.css";

import { brand } from "@cloudflare-starter/ui";

import SiteHeader from "@/components/site/SiteHeader.astro";
import WebAnalytics from "@/components/WebAnalytics.astro";

interface Props {
  title: string;
  /**
   * False on pages whose URL carries a credential (an invitation or reset token), so the
   * Web Analytics beacon never reports it.
   */
  analytics?: boolean;
}

const { title, analytics = true } = Astro.props;
const signedIn = Boolean(Astro.locals.user);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}{brand.titleSeparator}{brand.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="/site-theme.js"></script>
  </head>
  <body class="bg-canvas text-fg">
    <SiteHeader signedIn={signedIn} />
    <slot />
    {analytics && <WebAnalytics />}
  </body>
</html>
