---
/**
 * The document shell of the server-rendered account pages (sign-in, sign-up, password
 * reset, verification, invitations, consent). The header is the public site's
 * (SiteHeader: Docs, Changelog, Storybook, GitHub) with Sign in and Sign up, or Open app
 * when signed in. These pages are rendered per request under the page policy, which runs
 * scripts only from /_astro/: no public/site-theme.js, so no theme switch here and the OS
 * setting applies.
 */
import "@cloudflare-starter/ui/globals.css";
import "@/styles/globals.css";

import { brand, buttonVariants } from "@cloudflare-starter/ui";

import SiteHeader from "@/components/site/SiteHeader.astro";
import WebAnalytics from "@/components/WebAnalytics.astro";

interface Props {
  title: string;
  /**
   * False on pages whose URL carries a credential (an invitation or reset token), so the
   * Web Analytics beacon never reports it.
   */
  analytics?: boolean;
}

const { title, analytics = true } = Astro.props;
const signedIn = Boolean(Astro.locals.user);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}{brand.titleSeparator}{brand.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-canvas text-fg">
    <SiteHeader themeToggle={false}>
      <Fragment slot="actions">
        {
          signedIn ? (
            <a
              class={buttonVariants({ variant: "primary", size: "sm" })}
              href="/app/dashboard"
            >
              Open app
            </a>
          ) : (
            <>
              <a
                class={buttonVariants({ variant: "ghost", size: "sm" })}
                href="/sign-in"
              >
                Sign in
              </a>
              <a
                class={buttonVariants({ variant: "primary", size: "sm" })}
                href="/sign-up"
              >
                Sign up
              </a>
            </>
          )
        }
      </Fragment>
    </SiteHeader>
    <slot />
    {analytics && <WebAnalytics />}
  </body>
</html>
