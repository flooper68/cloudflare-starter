---
import "@cloudflare-starter/ui/globals.css";
import "@/styles/globals.css";

import { brand, Logo } from "@cloudflare-starter/ui";

interface Props {
  title: string;
}

const { title } = Astro.props;
const signedIn = Boolean(Astro.locals.user);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}{brand.titleSeparator}{brand.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="border-b border-line bg-surface backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href="/" aria-label={`${brand.name} home`}>
          <Logo />
        </a>
        <nav class="flex items-center gap-4 text-sm text-fg-muted [&_a:hover]:text-fg">
          <a href="/api/hello">API hello</a>
          {signedIn ? (
            <>
              <a href="/app/dashboard">Dashboard</a>
              <a href="/app/profile">Profile</a>
            </>
          ) : (
            <>
              <a href="/sign-in">Sign in</a>
              <a href="/sign-up">Sign up</a>
            </>
          )}
        </nav>
      </div>
    </header>
    <slot />
  </body>
</html>
