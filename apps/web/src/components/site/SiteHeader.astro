---
/**
 * The public header, on every public and account page: the logo and name, Docs,
 * Changelog and GitHub, the theme switch, a small Sign in link and one "Try the demo"
 * button (Open app instead of both when the page knows the visitor is signed in). On
 * phones: the logo, the button and a menu (SiteMenu). `docs` adds the Docs badge, the
 * wider layout and the `search` slot. The theme switch needs public/site-theme.js, which
 * every page's policy allows (docs/reference/docs-site.md#theme).
 */
import { Badge, buttonVariants, cn, LogoMark } from "@cloudflare-starter/ui";

import { DOCS } from "@/docs/docs.config";
import { LINKS } from "@/landing/content";

import SiteMenu from "./SiteMenu.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  variant?: "site" | "docs";
  /**
   * Known only on pages rendered per request (Layout.astro). Prerendered pages leave it
   * false: their "Try the demo" leads to /sign-up, which sends a signed-in visitor on to
   * the app.
   */
  signedIn?: boolean;
}

const { variant = "site", signedIn = false } = Astro.props;
const docs = variant === "docs";
const link =
  "rounded-sm font-medium text-fg-muted transition-colors hover:text-fg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus";
---

<header class="relative border-b border-line bg-canvas">
  <div
    class={cn(
      "mx-auto flex flex-wrap items-center gap-x-5 gap-y-3 px-4 py-3 sm:px-6",
      docs ? "max-w-[1360px]" : "max-w-6xl"
    )}
  >
    <a
      href="/"
      class="inline-flex shrink-0 items-center gap-2.5 rounded-md font-semibold text-fg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus"
    >
      <LogoMark className="size-6" />
      <span class={cn(docs && "max-sm:sr-only")}>{DOCS.siteName}</span>
      {docs && <Badge>Docs</Badge>}
    </a>
    <nav aria-label="Site" class="flex items-center gap-5 text-sm max-md:hidden">
      {
        !docs && (
          <a class={link} href={LINKS.docs}>
            Docs
          </a>
        )
      }
      <a class={link} href={LINKS.changelog}>Changelog</a>
      <a class={link} href={LINKS.github} data-track-cta="github" data-track-placement="header">GitHub</a>
    </nav>
    <slot name="search" />
    <span class="flex-1 max-md:hidden"></span>
    <div class="ml-auto flex shrink-0 items-center gap-2">
      <span class="contents max-md:hidden"><ThemeToggle /></span>
      {
        signedIn ? (
          <a
            class={buttonVariants({ variant: "primary", size: "sm" })}
            href={LINKS.app}
          >
            Open app
          </a>
        ) : (
          <>
            <a class={cn(link, "px-1 text-sm max-md:hidden")} href={LINKS.signIn}>
              Sign in
            </a>
            <a
              class={buttonVariants({ variant: "primary", size: "sm" })}
              href={LINKS.demo}
              data-track-cta="demo"
              data-track-placement="header"
            >
              Try the demo
            </a>
          </>
        )
      }
      <SiteMenu signedIn={signedIn} docs={docs} />
    </div>
  </div>
</header>
