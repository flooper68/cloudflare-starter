---
import { env } from "cloudflare:workers";

import { ForgotPasswordForm } from "@/components/auth/ForgotPasswordForm";
import Layout from "@/layouts/Layout.astro";
import { getAuthMethods } from "@/server/auth";
import { buildPlatform } from "@/server/platform";

// Password pages exist only while email + password sign-in is on.
if (!getAuthMethods(env).emailPassword) {
  return Astro.redirect("/sign-in");
}

if (Astro.locals.user) {
  return Astro.redirect("/app/dashboard");
}

const { turnstile } = buildPlatform(env);
---

<Layout title="Reset password">
  <main class="mx-auto flex min-h-[80vh] max-w-5xl items-center justify-center px-6 py-10">
    <ForgotPasswordForm client:load humanCheck={turnstile} />
  </main>
</Layout>
