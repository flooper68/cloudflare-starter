---
import "@cloudflare-starter/ui/globals.css";
import "@/styles/globals.css";

import { env } from "cloudflare:workers";

import { brand } from "@cloudflare-starter/ui";

import { AppSpa } from "@/components/app/AppSpa";
import WebAnalytics from "@/components/WebAnalytics.astro";
import { buildRequiredConfig } from "@/lib/env";
import { getAuthMethods } from "@/server/auth";

const { user } = Astro.locals;
const authUser = user
  ? {
      id: user.id,
      name: user.name,
      email: user.email,
      image: user.image ?? null,
    }
  : null;
const methods = getAuthMethods(env);
const { mode } = buildRequiredConfig(env).workspaces;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="noindex, nofollow" name="robots" />
    <title>{brand.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <script
      id="__APP_AUTH__"
      is:inline
      type="application/json"
      set:html={JSON.stringify({
        user: authUser,
        methods: { emailPassword: methods.emailPassword },
        workspace: { mode },
      })}
    />

    <AppSpa client:only="react" />
    <WebAnalytics spa />
  </body>
</html>
