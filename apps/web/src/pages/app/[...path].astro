---
import "@cloudflare-starter/ui/globals.css";
import "@/styles/globals.css";

import { AppSpa } from "@/components/app/AppSpa";

const { user } = Astro.locals;
const authUser = user
  ? {
      id: user.id,
      name: user.name,
      email: user.email,
      image: user.image ?? null,
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="noindex, nofollow" name="robots" />
    <title>Cloudflare Starter App</title>
  </head>
  <body>
    <script
      id="__APP_AUTH__"
      is:inline
      type="application/json"
      set:html={JSON.stringify({ user: authUser })}
    />

    <AppSpa client:only="react" />
  </body>
</html>
