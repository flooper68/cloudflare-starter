---
import "@cloudflare-starter/ui/globals.css";
import "@/styles/globals.css";

import { env } from "cloudflare:workers";

import { brand } from "@cloudflare-starter/ui";

import { AppSpa } from "@/components/app/AppSpa";
import WebAnalytics from "@/components/WebAnalytics.astro";
import { serializeBootstrap, spaBootstrap } from "@/server/spa-bootstrap";

const bootstrap = await spaBootstrap(env, Astro.locals);
---

<!doctype html>
<html lang={bootstrap.settings?.locale ?? "en"} data-theme={bootstrap.settings?.theme === "system" ? undefined : bootstrap.settings?.theme}>
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="noindex, nofollow" name="robots" />
    <title>{brand.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <script
      id="__APP_AUTH__"
      is:inline
      type="application/json"
      set:html={serializeBootstrap(bootstrap)}
    />

    <AppSpa client:only="react" />
    <WebAnalytics spa />
  </body>
</html>
