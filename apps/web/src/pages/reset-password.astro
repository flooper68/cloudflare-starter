---
import { env } from "cloudflare:workers";

import { ResetPasswordForm } from "@/components/auth/ResetPasswordForm";
import Layout from "@/layouts/Layout.astro";
import { getAuthMethods } from "@/server/auth";

// Password pages exist only while email + password sign-in is on.
if (!getAuthMethods(env).emailPassword) {
  return Astro.redirect("/sign-in");
}

// Better Auth redirects here with ?token=… (or ?error=INVALID_TOKEN).
const token = Astro.url.searchParams.get("token");
---

<Layout title="Choose a new password">
  <main class="mx-auto flex min-h-[80vh] max-w-5xl items-center justify-center px-6 py-10">
    <ResetPasswordForm client:load token={token} />
  </main>
</Layout>
