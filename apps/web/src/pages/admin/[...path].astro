---
import "@cloudflare-starter/ui/globals.css";
import "@/styles/globals.css";

import { env } from "cloudflare:workers";

import { brand } from "@cloudflare-starter/ui";

import { AppSpa } from "@/components/app/AppSpa";
import { serializeBootstrap, spaBootstrap } from "@/server/spa-bootstrap";

// The admin portal exists only for platform admins with ADMIN_PORTAL=on; everyone else,
// anonymous included, gets a plain 404 (no redirect that would reveal it).
const bootstrap = await spaBootstrap(env, Astro.locals);
if (!bootstrap.admin) {
  return new Response("Not Found", {
    status: 404,
    headers: { "content-type": "text/plain" },
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="noindex, nofollow" name="robots" />
    <title>Admin · {brand.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <script
      id="__APP_AUTH__"
      is:inline
      type="application/json"
      set:html={serializeBootstrap(bootstrap)}
    />

    <AppSpa client:only="react" />
  </body>
</html>
