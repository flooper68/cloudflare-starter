---
/**
 * The public 404, prerendered: Astro serves it for every unknown path outside the SPA
 * (/app/* has its own not-found screen). It offers the way back home, into the docs and
 * the docs search, the usual reason someone lands here being an old docs link.
 */
import { buttonVariants } from "@cloudflare-starter/ui";
import { BookOpen } from "lucide-react";

import DocsSearch from "@/components/site/DocsSearch.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import { DOCS } from "@/docs/docs.config";
import PublicLayout from "@/layouts/PublicLayout.astro";

export const prerender = true;
---

<PublicLayout title={`Page not found · ${DOCS.siteName}`} indexable={false}>
  <SiteHeader slot="header">
    <DocsSearch slot="search" />
  </SiteHeader>
  <main
    id="main"
    class="flex flex-1 items-center justify-center px-4 py-16 sm:px-6"
  >
    <div class="flex max-w-md flex-col items-center gap-3 text-center">
      <span class="font-mono text-sm text-fg-subtle">404</span>
      <h1 class="text-2xl font-semibold tracking-tight text-fg">
        This page doesn't exist
      </h1>
      <p class="text-sm text-fg-muted">
        The link may be old, or the address mistyped. The docs and the app are one
        click away.
      </p>
      <div class="mt-2 flex flex-wrap justify-center gap-2">
        <a class={buttonVariants({ variant: "primary" })} href="/">Go home</a>
        <a class={buttonVariants({ variant: "secondary" })} href="/docs/">
          <BookOpen aria-hidden="true" />Read the docs
        </a>
      </div>
    </div>
  </main>
</PublicLayout>
