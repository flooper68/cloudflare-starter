---
import { HomePage } from "@/components/HomePage";
import Layout from "@/layouts/Layout.astro";

const signedIn = Boolean(Astro.locals.user);

if (signedIn) {
  return Astro.redirect("/app/dashboard");
}
---

<Layout title="Cloudflare Starter">
  <HomePage client:load signedIn={signedIn} />
</Layout>
