---
/**
 * The docs site: one prerendered page per published repository file (DOCS.sources),
 * in the docs shell (layouts/DocsLayout.astro: navigation from docs/README.md, "On this
 * page", edit link, search). The rendered Markdown is what Pagefind indexes. The
 * changelog has its own page (changelog.astro). A doc with a `<!-- walkthrough: <id> -->`
 * line also loads the video player. docs/guides/how-to-publish-docs-and-landing.md
 */
import { getCollection, render } from "astro:content";
import { Prose } from "@cloudflare-starter/ui";
import PlayerAssets from "@/components/media/PlayerAssets.astro";
import { CHANGELOG_PATH } from "@/docs/changelog";
import { DOCS } from "@/docs/docs.config";
import { slugFor } from "@/docs/links";
import { docDescription } from "@/docs/meta";
import { buildNav, docTitle } from "@/docs/nav";
import { hasWalkthrough } from "@/docs/walkthroughs";
import DocsLayout from "@/layouts/DocsLayout.astro";

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  const titles = new Map(
    entries.map((entry) => [entry.id, docTitle(entry.body ?? "") ?? entry.id])
  );
  const index = entries.find((entry) => entry.id === DOCS.navSource);
  const nav = buildNav(index?.body ?? "", titles);
  return entries
    .filter((entry) => entry.id !== CHANGELOG_PATH)
    .map((entry) => ({
      params: { slug: slugFor(entry.id) || undefined },
      props: { entry, nav, title: titles.get(entry.id) ?? entry.id },
    }));
}

const { entry, nav, title } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
  path={entry.id}
  title={title}
  description={docDescription(entry.body ?? "")}
  nav={nav}
  headings={headings}
>
  <Prose>
    <Content />
  </Prose>
  {hasWalkthrough(entry.body ?? "") && <PlayerAssets />}
</DocsLayout>
