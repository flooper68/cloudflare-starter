---
import { ConsentForm } from "@/components/auth/ConsentForm";
import Layout from "@/layouts/Layout.astro";

// Better Auth sends signed-in users here during an MCP client's OAuth flow, with
// the signed authorization request as the query.
const params = Astro.url.searchParams;
const clientId = params.get("client_id");

if (!clientId) {
  return Astro.redirect("/app/dashboard");
}
if (!Astro.locals.user) {
  return Astro.redirect(`/sign-in${Astro.url.search}`);
}
// An admin impersonating this user may not connect an app as them; the consent endpoint
// refuses too (IMPERSONATION_OAUTH_REFUSED in server/auth.ts).
const impersonating = Boolean(Astro.locals.session?.impersonatedBy);
if (impersonating) {
  Astro.response.status = 403;
}
---

<Layout title={impersonating ? "Not allowed while impersonating" : "Allow access"}>
  <main class="mx-auto flex min-h-[80vh] max-w-5xl items-center justify-center px-6 py-10">
    {
      impersonating ? (
        <section
          role="alert"
          class="flex max-w-md flex-col gap-3 rounded-lg border border-line bg-surface-raised p-6 text-fg"
        >
          <h1 class="text-lg font-semibold">Not allowed while impersonating</h1>
          <p class="text-sm text-fg-muted">
            You are signed in as {Astro.locals.user.name} through impersonation.
            Connecting an app as them would outlast the impersonation, so it is
            refused. Stop impersonating from the banner in the app first.
          </p>
          <a class="text-sm text-accent-text underline" href="/app/dashboard">
            Back to the app
          </a>
        </section>
      ) : (
        <ConsentForm
          client:load
          clientId={clientId}
          redirectUri={params.get("redirect_uri")}
          scope={params.get("scope") ?? ""}
        />
      )
    }
  </main>
</Layout>
