# Copy to .env and fill in. See README.md for details.

# Core (required) — the app boots with just these set.
APP_URL=http://localhost:4321
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/cloudflare_starter

# Clerk (required) — required for authentication.
# The publishable key MUST be prefixed with PUBLIC_ so @clerk/astro can read it.
PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_...."
CLERK_SECRET_KEY="sk_test_...."

# R2 (optional) — required only for /app/upload-demo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_FILES_BUCKET_NAME=

# Mailjet (optional) — required only for /app/email-demo.
# Keep MAILJET_SANDBOX=true unless you intend to send real mail.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=
MAILJET_SANDBOX=true
