{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noImportCycles": "error"
      },
      "performance": {
        "noReExportAll": "error"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.astro",
      "!**/.wrangler",
      "!**/coverage",
      "!**/*.svg",
      "!**/public/_storybook",
      "!**/playwright-report",
      "!**/test-results",
      "!.claude/worktrees"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/features/src/index.ts",
        "packages/features/src/database.ts",
        "packages/ui/src/index.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/features/src/**/domain/**"],
      "plugins": ["./lint/rules/domain-purity.grit"]
    },
    {
      "includes": [
        "packages/features/src/**",
        "apps/web/src/server/**",
        "!packages/features/src/platform/adapters/cloudflare/**",
        "!**/*.test.ts"
      ],
      "plugins": ["./lint/rules/no-console.grit"]
    },
    {
      "includes": [
        "packages/ui/src/**",
        "apps/web/src/**",
        "!packages/ui/src/brand/**"
      ],
      "plugins": ["./lint/rules/tokens-only.grit"]
    },
    {
      "includes": ["apps/web/src/**", "!**/*.test.ts"],
      "plugins": ["./lint/rules/no-db-in-adapters.grit"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "drizzle-orm": "Adapters call use cases from packages/features; no database access in apps/web.",
                  "drizzle-orm/d1": "Adapters call use cases from packages/features; no database access in apps/web."
                }
              }
            }
          }
        }
      }
    }
  ]
}
