{
  // Bindings for the integration tests of packages/features (run in workerd by
  // @cloudflare/vitest-plugin). Local only: the ids are placeholders, nothing is deployed.
  "name": "features-integration-tests",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "features-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "features-test-files" }],
  // Producer only: tests check what a use case sends; nothing consumes it here.
  "queues": {
    "producers": [{ "binding": "APP_QUEUE", "queue": "features-test-queue" }]
  },
  // Workers Rate Limiting, simulated by Miniflare (the cloudflare RateLimiter contract test).
  "ratelimits": [
    {
      "name": "RL_TEST",
      "namespace_id": "9001",
      "simple": { "limit": 3, "period": 10 }
    }
  ]
}
