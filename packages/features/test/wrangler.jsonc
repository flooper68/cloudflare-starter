{
  // Bindings for the integration tests of packages/features (run in workerd by
  // @cloudflare/vitest-plugin). Local only: the ids are placeholders, nothing is deployed.
  "name": "features-integration-tests",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "features-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "features-test-files" }]
}
