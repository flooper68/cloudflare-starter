{
  "name": "cloudflare-starter",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @cloudflare-starter/web --filter @cloudflare-starter/container dev",
    "dev:web": "bun run --filter @cloudflare-starter/web dev",
    "dev:container": "bun run --filter @cloudflare-starter/container dev",
    "storybook": "bun run --filter @cloudflare-starter/storybook dev",
    "build-storybook": "bun run --filter @cloudflare-starter/storybook build",
    "build": "bun run --filter @cloudflare-starter/web build",
    "verify": "bun run typecheck && bun run lint && bun run test",
    "typecheck": "bun run --filter './packages/*' typecheck && bun run --filter './apps/*' typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "biome check . && bun run deps:check",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "db:generate": "bun run --filter @cloudflare-starter/features db:generate",
    "db:migrate:local": "bun run --filter @cloudflare-starter/web db:migrate:local",
    "setup:cloudflare": "bun scripts/setup-cloudflare.ts",
    "setup:secrets": "bun scripts/setup-secrets.ts",
    "setup:email": "bun scripts/setup-email.ts",
    "doctor": "bun scripts/doctor.ts",
    "setup:github-runner": "bun scripts/setup-github-runner.ts",
    "deps:check": "depcruise packages/features/src packages/ui/src --config .dependency-cruiser.cjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project features-integration --project web-api",
    "test:components": "bun run --filter @cloudflare-starter/storybook test",
    "test:e2e": "bun run --filter @cloudflare-starter/web test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.0",
    "jsonc-parser": "3.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
