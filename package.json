{
  "name": "cloudflare-starter",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @cloudflare-starter/web --filter @cloudflare-starter/queue-worker --filter @cloudflare-starter/cron-worker --filter @cloudflare-starter/container dev",
    "dev:web": "bun run --filter @cloudflare-starter/web dev",
    "dev:queue": "bun run --filter @cloudflare-starter/queue-worker dev",
    "dev:cron": "bun run --filter @cloudflare-starter/cron-worker dev",
    "dev:container": "bun run --filter @cloudflare-starter/container dev",
    "storybook": "bun run --filter @cloudflare-starter/storybook storybook",
    "build-storybook": "bun run --filter @cloudflare-starter/storybook build-storybook",
    "deploy:storybook": "bun run --filter @cloudflare-starter/storybook deploy",
    "build": "bun run --filter './apps/*' build",
    "verify": "bun run typecheck && bun run lint && bun run test",
    "typecheck": "bun run --filter './packages/*' typecheck && bun run --filter './apps/*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:new": "bun run --filter @cloudflare-starter/features db:new",
    "db:migrate": "bun run --filter @cloudflare-starter/features db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
